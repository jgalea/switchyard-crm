includes:
	- vendor/szepeviktor/phpstan-wordpress/extension.neon

parameters:
	level: 6
	paths:
		- src
	scanFiles:
		- conduit-crm.php
	bootstrapFiles:
		- tests/phpstan-bootstrap.php
	treatPhpDocTypesAsCertain: false
	ignoreErrors:
		# Host-plugin symbols. Every call site is behind an is_available()
		# check, and their classes are not installable as dev dependencies
		# without pulling in whole plugins.
		-
			message: '#(unknown class|Class|Instantiated class|invalid type|Access to property|Call to method|Call to static method).*(WC_|WCS_|GF[A-Z]|WPCF7|FluentCrm|Easy_Digital|WP_CLI|Lists|Subscriber|Tag)#'
			reportUnmatched: false
		-
			message: '#Function (wc_|edd_|EDD|FluentCrmApi|as_)[A-Za-z_]* not found#'
			reportUnmatched: false
		-
			message: '#Call to static method (add_command|error|success|log|warning|line|confirm)\(\) on an unknown class WP_CLI#'
			reportUnmatched: false
		# wp_setup_nav_menu_item() decorates WP_Post with these at runtime.
		-
			message: '#Access to an undefined property WP_Post::\$(type|object_id|menu_item_parent)#'
			path: src/Access/MenuFilter.php
